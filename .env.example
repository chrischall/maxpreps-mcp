# maxpreps-mcp needs no credentials. Everything here is optional tuning.

# Override the User-Agent sent to MaxPreps.
# MAXPREPS_USER_AGENT=

# Seconds to reuse a fetched page. Default 300. Set 0 to disable caching.
# MAXPREPS_CACHE_TTL=300

# Minimum spacing between requests, in milliseconds. Default 250.
# MAXPREPS_MIN_INTERVAL_MS=250

# Per-request timeout, in milliseconds. Default 20000.
# MAXPREPS_TIMEOUT_MS=20000
